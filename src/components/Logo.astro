---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import logo from '~/assets/images/logo.png';
import logoWhite from '~/assets/images/logo-white.png';
---

<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 flex items-center">
  <Image src={logo} alt={SITE?.name} height={40} class="h-9 md:h-10 w-auto dark:hidden" loading="eager" />
  <Image src={logoWhite} alt={SITE?.name} height={40} class="h-9 md:h-10 w-auto hidden dark:block" loading="eager" />
</span>
