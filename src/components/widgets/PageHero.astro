---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Compact photo band used as the heading of every sub page.

export interface Props {
  title: string;
  tagline?: string;
  subtitle?: string;
  image?: ImageMetadata;
  imagePosition?: string;
}

const { title, tagline, subtitle, image, imagePosition = 'center' } = Astro.props;
---

<section
  class="relative isolate overflow-hidden bg-slate-900 not-prose flex items-center min-h-[320px] md:min-h-[360px]"
>
  {
    image && (
      <Image
        src={image}
        alt=""
        widths={[640, 1024, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        format="webp"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        style={`object-position: ${imagePosition}`}
      />
    )
  }
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950/90 via-slate-950/75 to-slate-950/45"
    aria-hidden="true"
  >
  </div>
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-12">
    {tagline && <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-300/90">{tagline}</p>}
    <h1 class="mt-2 text-3xl md:text-5xl font-bold tracking-tight text-white font-heading">{title}</h1>
    {subtitle && <p class="mt-4 max-w-3xl text-base md:text-lg leading-relaxed text-slate-200">{subtitle}</p>}
  </div>
</section>
