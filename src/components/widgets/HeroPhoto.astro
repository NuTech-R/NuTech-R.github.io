---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import type { CallToAction } from '~/types';

// Full-bleed photo hero: the picture fills the section and a dark gradient keeps the text readable
// in both colour themes. Used on the home page.

export interface Props {
  image: ImageMetadata;
  alt: string;
  tagline?: string;
  badge?: { text: string; href?: string };
  actions?: Array<CallToAction>;
}

const { image, alt, tagline, badge, actions = [] } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-slate-950 not-prose">
  <Image
    src={image}
    alt={alt}
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    format="webp"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_center]"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950/90 via-slate-950/70 to-slate-950/20"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-24 bg-gradient-to-t from-slate-950/60" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28">
    <div class="max-w-2xl">
      {
        badge &&
          (badge.href ? (
            <a
              href={badge.href}
              class="inline-flex items-center gap-2 rounded-full border border-amber-300/40 bg-amber-400/15 px-3.5 py-1.5 text-sm font-medium text-amber-100 backdrop-blur hover:bg-amber-400/25 transition"
            >
              <span aria-hidden="true">🏆</span>
              {badge.text}
              <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="inline-flex items-center gap-2 rounded-full border border-amber-300/40 bg-amber-400/15 px-3.5 py-1.5 text-sm font-medium text-amber-100">
              <span aria-hidden="true">🏆</span>
              {badge.text}
            </span>
          ))
      }
      {tagline && <p class="mt-8 text-base font-medium text-slate-300">{tagline}</p>}
      <h1 class="mt-3 text-4xl md:text-5xl font-bold leading-tight tracking-tight text-white font-heading">
        <slot name="title" />
      </h1>
      <p class="mt-5 text-base md:text-lg leading-relaxed text-slate-200">
        <slot name="subtitle" />
      </p>
      {
        actions.length > 0 && (
          <div class="mt-10 flex flex-col sm:flex-row gap-4">
            {actions.map((action) => (
              <Button {...action} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
