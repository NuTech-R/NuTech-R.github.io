---
// Fonts come from Astro's native Fonts API (see `fonts` in astro.config.ts and
// <Font /> in Layout.astro): Inter for Latin text, Noto Sans JP for Japanese.
// Brand blue is taken from the NuTech-R logo (#0B5394); orange is the rescue accent.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter), var(--font-noto-jp), sans-serif;
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: var(--aw-font-sans);

    --aw-color-primary: rgb(11 83 148);
    --aw-color-secondary: rgb(8 62 112);
    --aw-color-accent: rgb(217 98 16);

    --aw-color-text-heading: rgb(12 22 36);
    --aw-color-text-default: rgb(30 41 56);
    --aw-color-text-muted: rgb(30 41 56 / 68%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(8 13 22);

    ::selection {
      background-color: rgb(11 83 148 / 18%);
    }
  }

  .dark {
    --aw-color-primary: rgb(56 132 210);
    --aw-color-secondary: rgb(122 178 235);
    --aw-color-accent: rgb(251 146 60);

    --aw-color-text-heading: rgb(241 245 250);
    --aw-color-text-default: rgb(214 224 236);
    --aw-color-text-muted: rgb(214 224 236 / 66%);
    --aw-color-bg-page: rgb(8 13 22);

    ::selection {
      background-color: rgb(56 132 210 / 45%);
      color: white;
    }
  }
</style>
