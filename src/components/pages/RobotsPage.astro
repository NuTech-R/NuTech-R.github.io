---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/widgets/PageHero.astro';
import Content from '~/components/widgets/Content.astro';
import Video from '~/components/widgets/Video.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { localize, type Lang } from '~/i18n';
import heroImage from '~/assets/images/seek-rubble.jpg';
import plantLever from '~/assets/images/field/plant-lever.jpg';
import rubbleSearch from '~/assets/images/field/rubble-search.jpg';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// 日本語と英語の文章。片方を直したらもう片方も直す。
// useCases の <wbr> は、狭い画面で折り返してよい位置。
const T = {
  ja: {
    title: 'ロボット',
    description:
      'NuTech-R が開発している作業用クローラーロボット「Seek」の紹介。6自由度アームと複数のカメラ・センサを備え、災害現場での調査やインフラ点検での活躍を目指しています。',
    heroSubtitle: '過酷な環境下での活躍を目指して開発している作業マニピュレータ付き\u200bクローラーロボットです。',
    overviewTitle: '機体の特徴',
    imageAlt:
      'Seek の各部（6自由度アーム、俯瞰アーム、エンドエフェクタ、Wi-Fi ルーター、3D LiDAR、メインクローラー、サブクローラー）',
    period: '開発時期：2024年11月〜現在',
    overview:
      '本体を覆うメインクローラーと4本のサブクローラーで優れた移動能力を発揮します。全長1.5m の6自由度アームに加え、カメラ付き3自由度の俯瞰アーム、5台の単眼カメラ・熱カメラ・3D LiDAR を備え、詳細な探査が可能です。',
    features: [
      { title: '移動', description: '本体を覆うメインクローラーと4本のサブクローラー', icon: 'tabler:route' },
      {
        title: 'アーム',
        description:
          '全長1.5m の6自由度アーム＋エンドエフェクタ（最大3kg の物体を持ち上げ可能）。ロボットを俯瞰して見るための、カメラ付き3自由度の俯瞰アームも搭載',
        icon: 'tabler:robot',
      },
      { title: 'センサ', description: '単眼カメラ5台・熱カメラ・3D LiDAR', icon: 'tabler:radar-2' },
      {
        title: '簡易防水',
        description: '配線をむき出しにしない構造で、簡易的な防水を施しています',
        icon: 'tabler:droplet',
      },
    ],
    operationTitle: '遠隔操縦',
    operationAlt: 'ゲームコントローラーと操縦用 PC で Seek を操縦している様子',
    operation:
      'Seek は、操縦用 PC とゲームコントローラーで離れた場所から操縦します。操縦者は PC の画面でカメラ映像や機体の状態を確認しながら、手元のゲームコントローラーで走行とアームを操作します。',
    operationItems: [
      {
        title: 'ゲームコントローラー',
        description: '市販のゲームコントローラー1つで、走行もアームも操作',
        icon: 'tabler:device-gamepad-2',
      },
      {
        title: '操縦用 PC',
        description: '複数のカメラ映像、機体とアームの姿勢（3D 表示）、操作モード、通信状態を1つの画面で確認',
        icon: 'tabler:device-laptop',
      },
      {
        title: '無線通信',
        description: '機体の Wi-Fi ルーターを通じて、ロボットが直接見えない場所から操縦します（目視外での遠隔操縦）',
        icon: 'tabler:wifi',
      },
    ],
    useCasesTitle: '想定する活用場面',
    useCasesSubtitle: '高い移動能力と多機能性により、幅広い分野での活躍が期待されます。',
    useCases: ['災害現場での<wbr>調査', 'インフラ<wbr>点検', '危険区域での<wbr>作業'],
    fieldTitle: '作業の様子',
    field: ['プラント内でのレバー開閉作業', '模擬瓦礫内での要救助者探索'],
    recordsTitle: '活動実績',
    records: [
      {
        tag: '大会',
        title: 'World Robot Summit 2025 過酷環境 F-REI チャレンジ プラント災害部門',
        badge: '優勝',
        note: '経済産業大臣賞',
        icon: 'tabler:trophy',
      },
      {
        tag: '展示',
        title: '2025国際ロボット展（iREX2025）、危機管理産業展2026（RISCON TOKYO）での展示デモ',
        icon: 'tabler:presentation',
      },
      {
        tag: '訓練',
        title: '厚木市合同防災訓練「ビッグレスキューかながわ」での陸上自衛隊や消防隊との訓練',
        icon: 'tabler:lifebuoy',
      },
    ],
    recordsLink: 'これまでの大会結果',
    videoTitle: 'Seek の動作動画',
    videoCaption: '災害対応レスキューロボット Seek 紹介動画（長岡技術科学大学）',
  },
  en: {
    title: 'Robot',
    description:
      'Seek, a crawler robot with a 6-DoF arm developed by NuTech-R for disaster-site surveys and infrastructure inspection.',
    heroSubtitle: 'A crawler robot with a work manipulator, built to operate in harsh environments.',
    overviewTitle: 'Key Features',
    imageAlt:
      'Parts of Seek: 6-DoF arm, overhead arm, end effector, Wi-Fi router, 3D LiDAR, main crawlers and sub-crawlers',
    period: 'In development: Nov 2024 – present',
    overview:
      'A main crawler covering the body and four sub-crawlers give Seek excellent mobility. It carries a 1.5 m 6-DoF arm, a 3-DoF overhead arm with a camera, five monocular cameras, a thermal camera and a 3D LiDAR for detailed exploration.',
    features: [
      { title: 'Mobility', description: 'Main crawler covering the body plus four sub-crawlers', icon: 'tabler:route' },
      {
        title: 'Arms',
        description:
          'A 1.5 m 6-DoF arm with an end effector (lifts up to 3 kg), plus a 3-DoF overhead arm with a camera for viewing the robot from above',
        icon: 'tabler:robot',
      },
      {
        title: 'Sensors',
        description: 'Five monocular cameras, a thermal camera and a 3D LiDAR',
        icon: 'tabler:radar-2',
      },
      {
        title: 'Basic Water Resistance',
        description: 'The wiring is kept enclosed, giving basic protection against water',
        icon: 'tabler:droplet',
      },
    ],
    operationTitle: 'Remote Operation',
    operationAlt: 'Operating Seek with a game controller and a control PC',
    operation:
      'Seek is operated remotely with a control PC and a game controller. The operator checks the camera feeds and the state of the robot on the PC screen while driving the robot and its arm with a handheld game controller.',
    operationItems: [
      {
        title: 'Game Controller',
        description: 'A single off-the-shelf game controller drives the robot and moves the arm',
        icon: 'tabler:device-gamepad-2',
      },
      {
        title: 'Control PC',
        description:
          'Camera feeds, the 3D pose of the robot and its arm, the control mode and the link status on one screen',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Wireless Link',
        description:
          'Operated over the Wi-Fi router on the robot from places where the robot is out of sight (beyond-line-of-sight operation)',
        icon: 'tabler:wifi',
      },
    ],
    useCasesTitle: 'Intended Applications',
    useCasesSubtitle: 'Its mobility and versatility should make it useful in a wide range of fields.',
    useCases: ['Disaster-site surveys', 'Infrastructure inspection', 'Work in hazardous areas'],
    fieldTitle: 'Seek at Work',
    field: ['Operating a lever in a plant', 'Searching for survivors in simulated rubble'],
    recordsTitle: 'Track Record',
    records: [
      {
        tag: 'Competition',
        title: 'World Robot Summit 2025 Harsh Environment F-REI Challenge — Plant Disaster Challenge',
        badge: 'Winner',
        note: 'Minister of Economy, Trade and Industry Award',
        icon: 'tabler:trophy',
      },
      {
        tag: 'Exhibitions',
        title: 'Live demonstrations at iREX2025 (International Robot Exhibition 2025) and RISCON TOKYO 2026',
        icon: 'tabler:presentation',
      },
      {
        tag: 'Drills',
        title:
          'Training with the Japan Ground Self-Defense Force and firefighters at Big Rescue Kanagawa, a joint disaster drill in Atsugi',
        icon: 'tabler:lifebuoy',
      },
    ],
    recordsLink: 'All competition results',
    videoTitle: 'Seek in Action',
    videoCaption: 'Seek, a disaster-response rescue robot (Nagaoka University of Technology) — video in Japanese',
  },
}[lang];

const useCaseIcons = ['tabler:alert-triangle', 'tabler:building-bridge', 'tabler:barrier-block'];
const fieldImages = [plantLever, rubbleSearch];
const metadata = { title: T.title, description: T.description };
---

<Layout metadata={metadata}>
  <PageHero tagline="Robot" title="Seek" subtitle={T.heroSubtitle} image={heroImage} imagePosition="center 45%" />

  <Content
    id="seek"
    tagline="Overview"
    isImageFirstOnMobile
    title={T.overviewTitle}
    image={{ src: '~/assets/images/seek-parts.jpg', alt: T.imageAlt, aspect: '4/3' }}
    items={T.features}
  >
    <Fragment slot="content">
      <p>
        <span
          class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary dark:bg-primary/25 dark:text-sky-200"
          >{T.period}</span
        >
      </p>
      <p class="mt-4">{T.overview}</p>
    </Fragment>
  </Content>

  <Content
    id="operation"
    isReversed
    isImageFirstOnMobile
    tagline="Operation"
    title={T.operationTitle}
    image={{ src: '~/assets/images/operation.jpg', alt: T.operationAlt, aspect: 'auto' }}
    items={T.operationItems}
  >
    <Fragment slot="content">{T.operation}</Fragment>
  </Content>

  <WidgetWrapper id="use-cases" containerClass="max-w-4xl mx-auto">
    <Headline tagline="Use Cases" title={T.useCasesTitle} subtitle={T.useCasesSubtitle} />
    <ul class="grid grid-cols-3 gap-3 sm:gap-6 list-none">
      {
        T.useCases.map((title, i) => (
          <li class="flex flex-col items-center gap-3 rounded-xl border border-gray-200 bg-white px-3 py-6 text-center dark:border-slate-800 dark:bg-slate-900">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary dark:bg-primary/25 dark:text-sky-200">
              <Icon name={useCaseIcons[i]} class="h-6 w-6" />
            </span>
            <span class="text-sm sm:text-base font-bold leading-snug text-heading" set:html={title} />
          </li>
        ))
      }
    </ul>
  </WidgetWrapper>

  <WidgetWrapper id="field" containerClass="max-w-5xl mx-auto">
    <Headline tagline="Gallery" title={T.fieldTitle} />
    <ul class="grid gap-6 sm:grid-cols-2 list-none">
      {
        T.field.map((caption, i) => (
          <li>
            <figure>
              <Image
                src={fieldImages[i]}
                alt={caption}
                widths={[480, 720]}
                sizes="(max-width: 639px) 100vw, 480px"
                format="webp"
                class="aspect-[3/2] w-full rounded-xl object-cover"
              />
              <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </WidgetWrapper>

  <WidgetWrapper id="records" containerClass="max-w-4xl mx-auto">
    <Headline tagline="Track Record" title={T.recordsTitle} />
    <ul class="flex flex-col gap-4 list-none">
      {
        T.records.map((r) => (
          <li class="flex gap-4 rounded-xl border border-gray-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary dark:bg-primary/25 dark:text-sky-200">
              <Icon name={r.icon} class="h-6 w-6" />
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-primary dark:text-sky-300">{r.tag}</p>
              <p class="mt-1 font-bold leading-snug text-heading">
                {r.title}
                {r.badge && (
                  <span class="ml-1 inline-block rounded-full bg-amber-100 px-2.5 py-0.5 align-middle text-xs font-bold text-amber-800 dark:bg-amber-400/20 dark:text-amber-200">
                    {r.badge}
                  </span>
                )}
              </p>
              {r.note && <p class="mt-1 text-sm text-muted">{r.note}</p>}
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-center">
      <a
        href={localize('/competition', lang)}
        class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline dark:text-sky-300"
      >
        {T.recordsLink}
        <Icon name="tabler:arrow-right" class="h-4 w-4" />
      </a>
    </p>
  </WidgetWrapper>

  <Video
    tagline="Movie"
    title={T.videoTitle}
    youtube="Hudw18oglWg"
    videoTitle={T.videoCaption}
    poster={{ src: '~/assets/images/seek-video.jpg', alt: T.videoCaption }}
    caption={T.videoCaption}
  />
</Layout>
