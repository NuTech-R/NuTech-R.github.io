---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  /** Overrides the site language from config.yaml (English pages). */
  lang?: string;
}

const { metadata = {}, lang } = Astro.props;
const { textDirection } = I18N;
const language = lang ?? I18N.language;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-noto-jp" />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    <slot />

    <Intersect />

    <script is:inline>
      // The site is also shown inside Google Sites (an iframe). Links to other sites must open in a
      // new tab: most sites refuse to be displayed inside a frame.
      if (!window.__nuExternalLinks) {
        window.__nuExternalLinks = true;
        const openExternalInNewTab = () => {
          document.querySelectorAll('a[href]').forEach((a) => {
            if (a.host && a.host !== location.host && !a.target) {
              a.target = '_blank';
              a.rel = 'noopener noreferrer';
            }
          });
        };
        openExternalInNewTab();
        // after client-side navigations (ClientRouter)
        document.addEventListener('astro:page-load', openExternalInNewTab);
      }
    </script>
  </body>
</html>
